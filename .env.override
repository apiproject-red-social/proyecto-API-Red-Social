# ======================================================
# LOCAL OVERRIDES (OPTIONAL)
# ======================================================
# This file is OPTIONAL and local-only.
# It can override values from `.env`.
# Useful for:
# - changing ports
# - using Docker DB instead of local
# - temporary experiments
# ======================================================

# Example: use Docker PostgreSQL instead of local
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/microblog_dev

# Example: change exposed port
# PORT=4000
