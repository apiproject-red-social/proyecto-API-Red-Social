# ==============================================================================
# CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# --- RED Y PUERTOS ---
# Puerto de exposición en el host (máquina anfitriona).
# Afecta al mapeo de puertos en Docker: ${PORT_API}:3000
PORT_API=3000

# --- BASE DE DATOS (PostgreSQL) ---
# Credenciales para la inicialización del contenedor y creación de la BD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=microblog_prod

# --- CONEXIÓN DE DATOS (DATABASE_URL) ---
# Formato: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
#
# 🐳 CASO A: EJECUCIÓN CON DOCKER (make demo / make dev-docker)
# El HOST debe coincidir con el nombre del servicio definido en el archivo .yml
# - Entorno Demo: demo-db
# - Entorno Dev:  dev-db
# - Entorno Test: test-db
# Ejemplo: DATABASE_URL=postgresql://postgres:secure_password_here@demo-db:5432/microblog_prod
#
# 💻 CASO B: EJECUCIÓN LOCAL (npm run dev / node dist/server.js)
# El HOST debe ser 'localhost' y el puerto debe estar mapeado en el contenedor o ser una instancia nativa.
# Ejemplo: DATABASE_URL=postgresql://postgres:secure_password_here@localhost:5432/microblog_prod
#
DATABASE_URL=postgresql://postgres:secure_password_here@demo-db:5432/microblog_prod

# --- CACHÉ (REDIS_URL) ---
# Formato: redis://[HOST]:[PORT]
# 🐳 Docker Demo: redis://demo-redis:6379
# 🐳 Docker Dev:  redis://dev-redis:6379
# 💻 Local:       redis://localhost:6379
REDIS_URL=redis://demo-redis:6379

# --- SEGURIDAD Y JWT ---
# Claves simétricas para la firma de Access y Refresh Tokens.
# Requeridas por el middleware de autenticación y servicios de Auth.
JWT_ACCESS_SECRET=cambiame_en_produccion_123
JWT_REFRESH_SECRET=cambiame_en_produccion_456

# --- CORS (Cross-Origin Resource Sharing) ---
# Define el origen permitido en la cabecera 'Access-Control-Allow-Origin'.
# ⚠️ IMPORTANTE: Si se modifica PORT_API, este valor debe actualizarse.
# Para permitir múltiples orígenes en desarrollo, usar '*' o el puerto asignado.
CORS_ORIGIN=http://localhost:3000